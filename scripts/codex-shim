#!/usr/bin/env bash
set -euo pipefail

ADAPTER="${CHRYS_CODEX_ADAPTER:-${CLAUDE_CODEX_ADAPTER:-$HOME/.local/share/chrys-codex-adapter/dist/src/adapter.mjs}}"
NODE_BIN="${CHRYS_CODEX_NODE:-${CLAUDE_CODEX_NODE:-node}}"
COMPAT_VERSION="${CHRYS_CODEX_COMPAT_VERSION:-${CODEX_SHIM_COMPAT_VERSION:-0.142.3}}"
VERSION_SUFFIX="${CHRYS_CODEX_VERSION_SUFFIX-chrys-codex}"

resolve_real_codex() {
  if [ -n "${CODEX_REAL:-}" ] && [ -x "$CODEX_REAL" ]; then
    printf '%s\n' "$CODEX_REAL"
    return 0
  fi
  local self candidate
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/$(basename "${BASH_SOURCE[0]}")"
  while IFS= read -r candidate; do
    [ -n "$candidate" ] || continue
    [ "$candidate" != "$self" ] || continue
    [ -x "$candidate" ] || continue
    printf '%s\n' "$candidate"
    return 0
  done < <({ type -P -a codex 2>/dev/null || which -a codex 2>/dev/null; } | awk '!seen[$0]++')
  return 1
}

case "${1:-}" in
  --version|-V|version)
    echo "${CODEX_SHIM_VERSION:-codex-cli ${COMPAT_VERSION}${VERSION_SUFFIX:+ (${VERSION_SUFFIX})}}"
    exit 0
    ;;
esac

# Codex Remote currently launches the daemon as
# `codex -c features.code_mode_host=true app-server ...`. The adapter does not
# consume Codex CLI global options, so forward from the app-server token onward.
args=("$@")
for ((index = 0; index < ${#args[@]}; index += 1)); do
  if [ "${args[$index]}" = "app-server" ]; then
    [ -f "$ADAPTER" ] || { echo "Chrys Codex adapter not found: $ADAPTER" >&2; exit 127; }
    # Codex App's SSH bootstrap expects the unix app-server command to
    # daemonize after its socket is ready. Keep direct/local invocations in the
    # foreground so development, tests, and explicit process supervision retain
    # their normal lifecycle.
    if [ -n "${SSH_CONNECTION:-}" ]; then
      for arg in "${args[@]:$index+1}"; do
        case "$arg" in
          unix://*|--listen=unix://*) export CHRYS_CODEX_DAEMONIZE=1 ;;
        esac
      done
    fi
    exec "$NODE_BIN" "$ADAPTER" "${args[@]:$index}"
  fi
done

REAL_CODEX="$(resolve_real_codex || true)"

if [ -n "$REAL_CODEX" ]; then
  exec "$REAL_CODEX" "$@"
fi

echo "Chrys codex shim supports --version and app-server; set CODEX_REAL for other commands" >&2
exit 127
